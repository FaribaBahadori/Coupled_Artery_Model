    <component name="calcium">
        <variable name="time" public_interface="in" units="second"/>
        <variable name="k1" public_interface="out" units="per_sec"/>
        <variable name="k2h" public_interface="out" units="per_sec"/>
        <variable initial_value="10" name="k1a" public_interface="out" units="per_sec"/>
        <!--init: 0.5962-->
        <variable name="Ca_in_SMC" public_interface="in" units="uM"/>
        <variable initial_value="0.05" name="Ca" units="uM"/>
        <variable name="Ca_in_SMC_dig" public_interface="in" units="uM"/>
        <variable initial_value="0.7" name="k1b" public_interface="out" units="uM"/>
        <!--it was var k1b: uM {init: 0.41, pub: out};
k1b was 0.7-->
        <variable initial_value="564.67" name="tp" public_interface="out" units="second"/>
        <variable initial_value="0" name="P" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="P0" units="dimensionless"/>
        <!--init: 0.5660310-->
        <!--0.5822 // init:0.001-->
        <variable name="kon" public_interface="out" units="dimensionless"/>
        <variable name="koff" public_interface="out" units="per_sec"/>
        <variable initial_value="76.23" name="k2b" public_interface="out" units="per_sec"/>
        <!--        var k2b: per_sec {init: 76.23, pub: out};-->
        <variable initial_value="0.000125" name="kon1" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.1" name="kon2" public_interface="out" units="uM"/>
        <!-- kon2 was 0.000174-->
        <variable initial_value="0.4629" name="koff1" public_interface="out" units="per_sec"/>
        <!--init: 0.4629-->
        <variable initial_value="120.84" name="koff2" public_interface="out" units="per_sec"/>
        <!-- koff2 was 120.84?!-->
        <variable name="p_agonist" public_interface="in" units="uM"/>
        <!--  var Ca_in_SMC2: uM {pub: in};
kon = kon1+sqr(Ca)/(sqr(kon2)+sqr(Ca));-->
        <variable initial_value="4" name="n1" units="dimensionless"/>
        <variable initial_value="2" name="n2" units="dimensionless"/>
        <variable initial_value="2" name="n2h" units="dimensionless"/>
        <variable name="k2y" public_interface="in" units="per_sec"/>
        <variable name="k1i" public_interface="out" units="per_sec"/>
        <variable name="k2hi" public_interface="out" units="per_sec"/>
        <variable name="koni" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="Pi" units="dimensionless"/>
        <variable initial_value="0" name="P0i" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>kon</ci>
                <apply>
                    <plus/>
                    <ci>kon1</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>n2</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>kon2</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                            <apply>
                                <power/>
                                <ci>Ca_in_SMC</ci>
                                <ci>n2</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--*k2y*1{sec}; //k2y*1{sec};//-->
            <apply>
                <eq/>
                <ci>koff</ci>
                <apply>
                    <plus/>
                    <ci>koff1</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>koff2</ci>
                            <ci>p_agonist</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <cn cellml:units="uM">1</cn>
                            <ci>p_agonist</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>P</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="d1imensionless">1</cn>
                        <ci>tp</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>kon</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>P</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>koff</ci>
                            <ci>P</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--P is the fraction of activated MLCP-->
            <apply>
                <eq/>
                <ci>k2h</ci>
                <apply>
                    <times/>
                    <ci>k2b</ci>
                    <apply>
                        <power/>
                        <ci>P</ci>
                        <ci>n2h</ci>
                    </apply>
                </apply>
            </apply>
            <!-- k1  = k1a*pow(Ca, 4{dimensionless})/(pow(k1b, 4{dimensionless})+pow(Ca, 4{dimensionless}));-->
            <apply>
                <eq/>
                <ci>k1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>k1a</ci>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>n1</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>k1b</ci>
                            <ci>n1</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>n1</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>koni</ci>
                <apply>
                    <plus/>
                    <ci>kon1</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC_dig</ci>
                            <ci>n2</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>kon2</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                            <apply>
                                <power/>
                                <ci>Ca_in_SMC_dig</ci>
                                <ci>n2</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Pi</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <cn cellml:units="d1imensionless">1</cn>
                        <ci>tp</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>koni</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>Pi</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>koff</ci>
                            <ci>Pi</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--P is the fraction of activated MLCP-->
            <apply>
                <eq/>
                <ci>k2hi</ci>
                <apply>
                    <times/>
                    <ci>k2b</ci>
                    <apply>
                        <power/>
                        <ci>Pi</ci>
                        <ci>n2h</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k1i</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>k1a</ci>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC_dig</ci>
                            <ci>n1</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>k1b</ci>
                            <ci>n1</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC_dig</ci>
                            <ci>n1</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
