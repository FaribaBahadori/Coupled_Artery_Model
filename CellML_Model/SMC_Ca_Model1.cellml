                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.05</cn>
                                </apply>
                                <cn cellml:units="uM">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <cn cellml:units="second">266</cn>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <cn cellml:units="second">313.5</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>oo</ci>
                                <cn cellml:units="uM">0.05</cn>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <ci>oo</ci>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <times/>
                                            <cn cellml:units="dimensionless">3.84</cn>
                                            <apply>
                                                <power/>
                                                <cn cellml:units="dimensionless">10</cn>
                                                <apply>
                                                    <minus/>
                                                    <cn cellml:units="dimensionless">11</cn>
                                                </apply>
                                            </apply>
                                            <apply>
                                                <power/>
                                                <apply>
                                                    <minus/>
                                                    <apply>
                                                        <times/>
                                                        <ci>time</ci>
                                                        <cn cellml:units="per_sec">1</cn>
                                                    </apply>
                                                    <cn cellml:units="dimensionless">313.5</cn>
                                                </apply>
                                                <cn cellml:units="dimensionless">3</cn>
                                            </apply>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <cn cellml:units="dimensionless">9.63</cn>
                                            <apply>
                                                <power/>
                                                <cn cellml:units="dimensionless">10</cn>
                                                <apply>
                                                    <minus/>
                                                    <cn cellml:units="dimensionless">5</cn>
                                                </apply>
                                            </apply>
                                            <apply>
                                                <minus/>
                                                <apply>
                                                    <times/>
                                                    <ci>time</ci>
                                                    <cn cellml:units="per_sec">1</cn>
                                                </apply>
                                                <cn cellml:units="dimensionless">313.5</cn>
                                            </apply>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">0.326136</cn>
                                </apply>
                                <cn cellml:units="uM">1</cn>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <cn cellml:units="second">313.5</cn>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <cn cellml:units="second">902</cn>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>oo</ci>
                                <cn cellml:units="uM">0.05</cn>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <ci>oo</ci>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <times/>
                                            <apply>
                                                <minus/>
                                                <cn cellml:units="dimensionless">4.16</cn>
                                            </apply>
                                            <apply>
                                                <power/>
                                                <cn cellml:units="dimensionless">10</cn>
                                                <apply>
                                                    <minus/>
                                                    <cn cellml:units="dimensionless">11</cn>
                                                </apply>
                                            </apply>
                                            <apply>
                                                <power/>
                                                <apply>
                                                    <minus/>
                                                    <apply>
                                                        <times/>
                                                        <ci>time</ci>
                                                        <cn cellml:units="per_sec">1</cn>
                                                    </apply>
                                                    <cn cellml:units="dimensionless">902</cn>
                                                </apply>
                                                <cn cellml:units="dimensionless">3</cn>
                                            </apply>
