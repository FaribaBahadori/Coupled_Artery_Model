                    </apply>
                    <apply>
                        <times/>
                        <ci>phi2</ci>
                        <ci>y</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Ca_in_SMC</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>delta2</ci>
                        <apply>
                            <minus/>
                            <ci>J_release</ci>
                            <ci>J_serca</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>delta_SMC</ci>
                        <apply>
                            <minus/>
                            <ci>J_in</ci>
                            <ci>J_pm</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>rate1</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>delta2</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <ci>n_release</ci>
                                <ci>J_release</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>n_serca</ci>
                                <ci>J_serca</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>delta_SMC</ci>
                        <apply>
                            <minus/>
                            <ci>J_in</ci>
                            <ci>J_pm</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>rate_m0</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC0</ci>
                    <apply>
                        <minus/>
                        <ci>J_in</ci>
                        <ci>J_pm</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>rate_SR</ci>
                <apply>
                    <times/>
                    <ci>delta2</ci>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>n_release</ci>
                            <ci>J_release</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>n_serca</ci>
                            <ci>J_serca</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>rate_m</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC</ci>
                    <apply>
                        <minus/>
                        <ci>J_in</ci>
                        <ci>J_pm</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Ca_SR</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>gamma</ci>
                    <apply>
                        <minus/>
                        <ci>J_serca</ci>
                        <ci>J_release</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>Ca_t</ci>
                <apply>
                    <plus/>
                    <ci>Ca_in_SMC</ci>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>gamma</ci>
                        </apply>
                        <ci>Ca_SR</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>exp1</ci>
                <apply>
                    <minus/>
                    <apply>
                        <exp/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>nv</ci>
                                </apply>
                                <ci>V</ci>
                                <ci>F</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--   ode(Ca_in_SMC2, time) = delta2*(J_release-J_serca)+delta_SMC*(J_L_typeD-J_pm2);
   J_pm2                 = n_pm*Vp*pow(Ca_in_SMC2, np)/(pow(Kp, np)+pow(Ca_in_SMC2, np));-->
            <!-- (0.0044138736{dimensionless}*(time*1{per_sec}-266{dimensionless})+0.116477{dimensionless})*1{uM};-->
            <!--0.116477{uM};-->
            <apply>
                <eq/>
