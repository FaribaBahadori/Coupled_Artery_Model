                        <apply>
                            <times/>
                            <ci>l_m2</ci>
                            <ci>p_agonist</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>l_m4</ci>
                            <ci>L3</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>L3</ci>
                        <ci>p_agonist</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>y</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>phi1</ci>
                        <apply>
                            <minus/>
