<?xml version='1.0' encoding='UTF-8'?>
<!-- this is same as file "Hill_test01.cellml" only I have made the following changes
   time period of KCl was changed from "t1_KCL=100 and t2_KCL=2000" to  "t1_KCL=266 and t2_KCL=2066"-->
<model name="Test1" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#" xmlns:xlink="http://www.w3.org/1999/xlink">
    <import xlink:href="EC_SMC_Units.cellml">
        <units name="C_per_mol" units_ref="C_per_mol"/>
        <units name="first_order_rate_constant" units_ref="first_order_rate_constant"/>
        <units name="mJ_per_K_per_mol" units_ref="mJ_per_K_per_mol"/>
        <units name="M_per_cmsq" units_ref="M_per_cmsq"/>
        <units name="mV" units_ref="mV"/>
        <units name="per_sec" units_ref="per_sec"/>
        <units name="per_uM" units_ref="per_uM"/>
        <units name="per_uM2" units_ref="per_uM2"/>
        <units name="per_uM_per_sec" units_ref="per_uM_per_sec"/>
        <units name="uM" units_ref="uM"/>
        <units name="nS_per_uM" units_ref="nS_per_uM"/>
        <units name="uA_per_cmsq" units_ref="uA_per_cmsq"/>
        <units name="uM2" units_ref="uM2"/>
        <units name="umol_per_cmsq" units_ref="umol_per_cmsq"/>
        <units name="uM_per_sec" units_ref="uM_per_sec"/>
    </import>
    <import xlink:href="SMC_Ca_Model1.cellml">
        <component component_ref="asm_ca" name="asm_ca"/>
        <component component_ref="ca_parameters" name="ca_parameters"/>
        <component component_ref="calcium" name="calcium"/>
    </import>
    <import xlink:href="SMC_NO_Model1.cellml">
        <component component_ref="sGC_SMC" name="sGC_SMC"/>
    </import>
    <import xlink:href="EC_Model1.cellml">
        <component component_ref="Activation_of_G_proteins" name="Activation_of_G_proteins"/>
        <component component_ref="Activation_of_protein_kinases" name="Activation_of_protein_kinases"/>
        <component component_ref="Calcium_signalling" name="Calcium_signalling"/>
        <component component_ref="NO_production" name="NO_production"/>
        <component component_ref="Phosphorylation_and_formation_of_eNOS_complexes" name="Phosphorylation_and_formation_of_eNOS_complexes"/>
    </import>
    <component name="Environment">
        <variable name="tau" public_interface="out" units="dimensionless"/>
        <variable initial_value="0" name="tau0" units="dimensionless"/>
        <variable initial_value="20" name="tau1" units="dimensionless"/>
        <variable initial_value="8" name="tau2" units="dimensionless"/>
        <variable initial_value="16" name="tau3" units="dimensionless"/>
        <variable initial_value="0" name="tau_c" units="dimensionless"/>
        <variable initial_value="0" name="t0_tau" units="second"/>
        <variable initial_value="300" name="t1_tau" units="second"/>
        <!--40 -->
        <variable initial_value="350" name="t2_tau" units="second"/>
        <!--110-->
        <variable initial_value="400" name="t3_tau" units="second"/>
        <!--170-->
        <variable initial_value="500" name="t4_tau" units="second"/>
        <!--280-->
        <variable initial_value="0" name="tn0" units="dimensionless"/>
        <!-- when tn0==1,tn1 =tn2=0)  then tau is a step function of time-->
        <variable initial_value="0" name="tn1" units="dimensionless"/>
        <!--when tn1=1,tn2=tn0=0) then  tau==tau_c -->
        <variable initial_value="1" name="tn2" units="dimensionless"/>
        <!--when tn2=1,tn1=tn0=0) then (tau==tau_c for (t1_tau<time<=t4_time) , otherwise tau==tau0-->
        <variable name="time" public_interface="out" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>tau</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>tau0</ci>
                                <ci>tn0</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau0</ci>
                                <ci>tn2</ci>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t0_tau</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t1_tau</ci>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>tau1</ci>
                                <ci>tn0</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn2</ci>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t1_tau</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t2_tau</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>tau0</ci>
                                <ci>tn0</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau0</ci>
                                <ci>tn2</ci>
                            </apply>
                        </apply>
                    </otherwise>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>tau2</ci>
                                <ci>tn0</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn2</ci>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t2_tau</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t3_tau</ci>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>tau3</ci>
                                <ci>tn0</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>tau_c</ci>
                                <ci>tn2</ci>
                            </apply>
                        </apply>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t3_tau</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t4_tau</ci>
                            </apply>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
        </math>
    </component>
    <!--start of SMC_calcium_file_$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$-->
    <!--Ca_Model-->
    <!--End of SMC_calcium_file_$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$    -->
    <component name="SMC_Par">
        <variable name="Ca_in_SMC" public_interface="in" units="uM"/>
        <variable name="Ca_in_SMC0" public_interface="in" units="uM"/>
        <!--        var Ca_in_SMC_dig: uM {pub: in};-->
        <variable name="Ca_SR" public_interface="in" units="uM"/>
        <variable name="Ca_SR0" public_interface="in" units="uM"/>
        <variable name="Ca_t" public_interface="in" units="uM"/>
        <variable name="I_ca" public_interface="in" units="uA_per_cmsq"/>
        <variable name="J_release" public_interface="in" units="uM_per_sec"/>
        <variable name="rate1" public_interface="in" units="uM_per_sec"/>
        <variable name="rate_SR" public_interface="in" units="uM_per_sec"/>
        <variable name="rate_m" public_interface="in" units="uM_per_sec"/>
        <variable name="rate_m0" public_interface="in" units="uM_per_sec"/>
        <variable name="J_serca" public_interface="in" units="uM_per_sec"/>
        <variable name="J_in" public_interface="in" units="uM_per_sec"/>
        <variable name="J_pm" public_interface="in" units="uM_per_sec"/>
        <!--var k_mlcpb: per_sec {pub: in};
var k_mlcpc: per_sec {pub: in};
var k_mlcpm: uM {pub: in};-->
        <variable name="m" public_interface="in" units="dimensionless"/>
        <variable name="P" public_interface="in" units="dimensionless"/>
        <variable name="p_agonist" public_interface="in" units="uM"/>
        <variable name="P_ipr" public_interface="in" units="dimensionless"/>
        <variable name="P_RyR" public_interface="in" units="dimensionless"/>
        <variable name="V_ca" public_interface="in" units="mV"/>
        <variable name="V" public_interface="in" units="vmV"/>
        <!--        var t_ago1: second {pub: in};
        var p_ago1: uM {pub: in};-->
        <variable name="V0" public_interface="in" units="mV"/>
        <variable name="V1" public_interface="in" units="mV"/>
        <variable name="t1_KCL" public_interface="in" units="second"/>
        <variable name="t2_KCL" public_interface="in" units="second"/>
        <variable name="Ca_E" public_interface="in" units="uM"/>
        <variable name="y" public_interface="in" units="dimensionless"/>
        <variable name="y0" public_interface="in" units="dimensionless"/>
        <variable name="phi1" public_interface="in" units="per_sec"/>
        <variable name="phi2" public_interface="in" units="per_sec"/>
        <variable name="l_1" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_2" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_3" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_4" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_5" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_m1" public_interface="in" units="per_sec"/>
        <variable name="l_m2" public_interface="in" units="per_sec"/>
        <variable name="l_m3" public_interface="in" units="per_sec"/>
        <variable name="l_m4" public_interface="in" units="per_sec"/>
        <variable name="l_m5" public_interface="in" units="per_sec"/>
        <variable name="L1" public_interface="in" units="uM"/>
        <variable name="L2" public_interface="in" units="uM"/>
        <variable name="L3" public_interface="in" units="uM"/>
        <variable name="L4" public_interface="in" units="uM"/>
        <variable name="L5" public_interface="in" units="uM"/>
        <variable name="k_ryr0" public_interface="in" units="dimensionless"/>
        <variable name="k_ryr1" public_interface="in" units="dimensionless"/>
        <variable name="k_ryr2" public_interface="in" units="uM"/>
        <variable name="k_ryr3" public_interface="in" units="uM"/>
        <variable name="delta_SMC" public_interface="in" units="dimensionless"/>
        <variable name="delta2" public_interface="in" units="dimensionless"/>
        <variable name="k_ipr" public_interface="in" units="per_sec"/>
        <variable name="k_RyR" public_interface="in" units="per_sec"/>
        <variable name="Vm" public_interface="in" units="mV"/>
        <variable name="km" public_interface="in" units="mV"/>
        <variable name="gca" public_interface="in" units="nS_per_uM"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable name="R" public_interface="in" units="mJ_per_K_per_mol"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="alpha0" public_interface="in" units="uM_per_sec"/>
        <variable name="alpha1" public_interface="in" units="dimensionless"/>
        <variable name="alpha2" public_interface="in" units="per_sec"/>
        <variable name="Jer" public_interface="in" units="per_sec"/>
        <variable name="Ve" public_interface="in" units="uM_per_sec"/>
        <variable name="Ke" public_interface="in" units="uM"/>
        <variable name="Vp" public_interface="in" units="uM_per_sec"/>
        <variable name="Kp" public_interface="in" units="uM"/>
        <variable name="gamma" public_interface="in" units="dimensionless"/>
        <variable name="Ca_dSR" units="uM"/>
        <variable name="ne" public_interface="in" units="dimensionless"/>
        <variable name="np" public_interface="in" units="dimensionless"/>
        <variable name="nc" public_interface="in" units="dimensionless"/>
        <variable name="ns" public_interface="in" units="dimensionless"/>
        <variable name="ns0" public_interface="in" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Ca_dSR</ci>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <cn cellml:units="uM">27.5</cn>
                            <ci>Ca_SR</ci>
                        </apply>
                        <ci>Ca_in_SMC</ci>
                    </apply>
                    <cn cellml:units="uM">0.05</cn>
                </apply>
            </apply>
        </math>
    </component>
    <component name="NO_sGC">
        <variable name="cGMP_EC" public_interface="in" units="uM"/>
        <!--       var cGMP_SMC: uM {pub: in};
        var E5c: dimensionless {pub: in};
        var E6c: dimensionless {pub: in};
        var Eb: dimensionless {pub: in};-->
        <variable name="eNOS_CaM" public_interface="in" units="uM"/>
        <variable name="eNOS_CaM_star" public_interface="in" units="uM"/>
        <!--        var h_four: per_sec {pub: in};-->
        <variable name="J_dif" public_interface="out" units="uM_per_sec"/>
        <!--        var J_no: uM_per_sec {pub: in};-->
        <variable initial_value="0.1" name="k_dif" units="uM_per_sec"/>
        <!--        var Km_pde: uM {pub: in};
        var K_pde: per_sec {pub: in};
        var n_mlcph: dimensionless {pub: in};-->
        <variable name="NO_EC" public_interface="in" units="uM"/>
        <!--        var NO_SMC: uM {pub: in};-->
        <variable name="Q_sGC" public_interface="in" units="uM_per_sec"/>
        <variable name="Q_NO" public_interface="in" units="uM_per_sec"/>
        <variable name="Q_RBC" public_interface="in" units="uM_per_sec"/>
        <variable name="NO_rate" public_interface="in" units="uM_per_sec"/>
        <!--        var vd: uM_per_sec {pub: in};
        var vp: uM_per_sec {pub: in};-->
        <!--Parameter values copied from NO_cGMp_signalling_SMC.cellml file, SGC_SMC component............. starts....-->
        <variable name="Eb" public_interface="in" units="dimensionless"/>
        <!--var Eb: dimensionless {pub: out};-->
        <variable name="E6c" public_interface="in" units="dimensionless"/>
        <variable initial_value="0" name="E6c0" public_interface="out" units="dimensionless"/>
        <variable name="E5c" public_interface="in" units="dimensionless"/>
        <variable initial_value="0" name="E5c0" public_interface="out" units="dimensionless"/>
        <variable name="NO_SMC" public_interface="in" units="uM"/>
        <variable initial_value="0" name="NO_SMC0" public_interface="out" units="uM"/>
        <variable initial_value="2000" name="h_one" public_interface="out" units="per_uM_per_sec"/>
        <variable initial_value="100" name="hm1" public_interface="out" units="per_sec"/>
        <variable initial_value="0.1" name="h_two" public_interface="out" units="per_sec"/>
        <variable initial_value="3" name="h_three" public_interface="out" units="per_uM_per_sec"/>
        <variable name="h_four" public_interface="in" units="per_sec"/>
        <variable name="cGMP_SMC" public_interface="in" units="uM"/>
        <variable initial_value="0" name="cGMP_SMC0" public_interface="out" units="uM"/>
        <variable name="vd" public_interface="in" units="uM_per_sec"/>
        <variable name="vp" public_interface="in" units="uM_per_sec"/>
        <variable initial_value="0.852" name="Vm_sgc" public_interface="out" units="uM_per_sec"/>
        <variable initial_value="2" name="Km_pde" public_interface="out" units="uM"/>
        <variable initial_value="0.0195" name="K_pde" public_interface="out" units="per_sec"/>
        <variable initial_value="0.01" name="k_dno" public_interface="out" units="per_sec"/>
        <variable initial_value="0.003" name="J_no" public_interface="out" units="uM_per_sec"/>
        <variable initial_value="2" name="m" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.011" name="H_four" public_interface="out" units="per_sec"/>
        <variable initial_value="0.0086" name="k_mlcpb" public_interface="out" units="per_sec"/>
        <!--init: 0.0086, -->
        <variable initial_value="0.5" name="k_mlcpc" public_interface="out" units="per_sec"/>
        <!--init: 0.0327-->
        <variable initial_value="5.5" name="k_mlcpm" public_interface="out" units="uM"/>
        <variable initial_value="2" name="n_mlcph" public_interface="out" units="dimensionless"/>
        <!--     var k2y: per_sec {pub: in};-->
        <!-- k2y=k_mlcp in Yang et al. (2005)-->
        <!--Parameter values copied from NO_cGMp_signalling_SMC.cellml file, SGC_SMC component............. Ends....-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>J_dif</ci>
                <apply>
                    <times/>
                    <ci>k_dif</ci>
                    <apply>
                        <minus/>
                        <ci>NO_EC</ci>
                        <ci>NO_SMC</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="kay2">
        <variable name="time" public_interface="in" units="second"/>
        <variable name="k1a" public_interface="in" units="per_sec"/>
        <variable name="k1b" public_interface="in" units="per_sec"/>
        <variable name="k2" public_interface="out" units="per_sec"/>
        <variable name="k2y" public_interface="in" units="per_sec"/>
        <variable name="k2h" public_interface="in" units="per_sec"/>
        <variable initial_value="0.88" name="k3" public_interface="out" units="first_order_rate_constant"/>
        <variable name="k_dno" public_interface="in" units="per_sec"/>
        <variable name="k2b" public_interface="in" units="per_sec"/>
        <variable name="kon" public_interface="in" units="dimensionless"/>
        <variable name="koff" public_interface="in" units="per_sec"/>
        <variable name="kon1" public_interface="in" units="dimensionless"/>
        <variable name="kon2" public_interface="in" units="uM"/>
        <variable name="koff1" public_interface="in" units="per_sec"/>
        <variable name="koff2" public_interface="in" units="per_sec"/>
        <variable name="tp" public_interface="in" units="second"/>
        <variable initial_value="1" name="mm" units="dimensionless"/>
        <variable name="k2i" public_interface="out" units="per_sec"/>
        <variable name="k2hi" public_interface="in" units="per_sec"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>k2</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>k2h</ci>
                        <ci>k2y</ci>
                    </apply>
                    <ci>mm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>k2i</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <ci>k2hi</ci>
                        <ci>k2y</ci>
                    </apply>
                    <ci>mm</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="M">
        <variable name="AM" public_interface="in" units="dimensionless"/>
        <variable initial_value="1" name="M" public_interface="out" units="dimensionless"/>
        <variable name="Mp" public_interface="in" units="dimensionless"/>
        <variable name="k1" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k2" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k7" public_interface="in" units="first_order_rate_constant"/>
        <variable name="time" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>M</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>k1</ci>
                        </apply>
                        <ci>M</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k2</ci>
                        <ci>Mp</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k7</ci>
                        <ci>AM</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="Mp">
        <variable name="AMp" public_interface="in" units="dimensionless"/>
        <variable initial_value="0" name="Mp" public_interface="out" units="dimensionless"/>
        <variable name="M" public_interface="in" units="dimensionless"/>
        <variable name="k1" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k2" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k3" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k4" public_interface="in" units="first_order_rate_constant"/>
        <variable name="time" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>Mp</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>k4</ci>
                            <ci>AMp</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k1</ci>
                            <ci>M</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>k2</ci>
                            <ci>k3</ci>
                        </apply>
                        <ci>Mp</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="AM">
        <variable initial_value="0" name="AM" public_interface="out" units="dimensionless"/>
        <variable name="AMp" public_interface="in" units="dimensionless"/>
        <variable name="k5" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k6" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k7" public_interface="in" units="first_order_rate_constant"/>
        <variable name="time" public_interface="in" units="second"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>AM</ci>
                </apply>
                <apply>
