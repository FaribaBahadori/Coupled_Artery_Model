                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">636</cn>
                                </apply>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">639</cn>
                                </apply>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="uM">1.525959528</cn>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">1282</cn>
                                </apply>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">1285</cn>
                                </apply>
                            </apply>
                        </apply>
                    </piece>
                    <piece>
                        <cn cellml:units="uM">1.553018198</cn>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">1932</cn>
                                </apply>
                            </apply>
                            <apply>
                                <lt/>
                                <ci>time</ci>
                                <apply>
                                    <plus/>
                                    <ci>tb</ci>
                                    <cn cellml:units="second">1935</cn>
                                </apply>
                            </apply>
                        </apply>
                    </piece>
                </piecewise>
            </apply>
        </math>
        <!--I should fix time period lated from 266-2060 to 0-1794-->
    </component>
    <component name="model_parameters1">
        <variable name="k1" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k2" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k5" public_interface="out" units="first_order_rate_constant"/>
        <variable name="k6" public_interface="out" units="first_order_rate_constant"/>
        <variable initial_value="0.22" name="k4" public_interface="out" units="first_order_rate_constant"/>
        <variable initial_value="0.0003" name="k7" public_interface="out" units="first_order_rate_constant"/>
        <!-- var k12: first_order_rate_constant;-->
        <!--init:0.0003
var k7: first_order_rate_constant {pub: out};-->
        <!--init: 0.03,-->
        <variable initial_value="2" name="kca" public_interface="out" units="dimensionless"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="P" public_interface="in" units="dimensionless"/>
        <variable name="k1i" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k2i" public_interface="in" units="first_order_rate_constant"/>
        <variable name="k5i" public_interface="out" units="first_order_rate_constant"/>
        <variable name="k6i" public_interface="out" units="first_order_rate_constant"/>
        <!--        var Pi: dimensionless {pub: in};-->
        <!--        var b: dimensionless {init: 4};
        var k12: dimensionless;
        var k7min: dimensionless {init: 0.0001};
        var k7max: dimensionless {init: 0.003};
        var alpha7: dimensionless {init: 1e-06};-->
        <!--  k7 = k12;-->
        <!--k12 = k7min+alpha7*(k7max-k7min)/(alpha7+k1*1{second}/(k2*1{second}+0.000000000000001{dimensionless}));-->
        <!--  k7 = sqr(k1)/(k2+0.000000000000001{dimensionless});-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>k6</ci>
                <ci>k1</ci>
            </apply>
            <apply>
                <eq/>
                <ci>k5</ci>
                <ci>k2</ci>
            </apply>
            <apply>
                <eq/>
                <ci>k6i</ci>
                <ci>k1i</ci>
            </apply>
            <apply>
                <eq/>
                <ci>k5i</ci>
                <ci>k2i</ci>
            </apply>
        </math>
    </component>
