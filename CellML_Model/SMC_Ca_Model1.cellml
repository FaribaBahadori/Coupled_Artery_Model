        <variable name="Ke" public_interface="in" units="uM"/>
        <variable name="Vp" public_interface="in" units="uM_per_sec"/>
        <variable name="Kp" public_interface="in" units="uM"/>
        <variable name="alpha0" public_interface="in" units="uM_per_sec"/>
        <variable name="alpha1" public_interface="in" units="dimensionless"/>
        <variable name="alpha2" public_interface="in" units="per_sec"/>
        <variable name="F" public_interface="in" units="C_per_mol"/>
        <variable initial_value="0.459" name="y" public_interface="out" units="dimensionless"/>
        <variable initial_value="0.459" name="y0" public_interface="out" units="dimensionless"/>
        <!-- init:0.48 //init: 0.53-->
        <!--var y0: dimensionless {init: 0.38, pub: out}; //init: 0.624736368 // 0.38-->
        <variable name="phi1" public_interface="out" units="per_sec"/>
        <variable name="phi2" public_interface="out" units="per_sec"/>
        <variable name="l_1" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_2" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_3" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_4" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_5" public_interface="in" units="per_uM_per_sec"/>
        <variable name="l_m1" public_interface="in" units="per_sec"/>
        <variable name="l_m2" public_interface="in" units="per_sec"/>
        <variable name="l_m3" public_interface="in" units="per_sec"/>
        <variable name="l_m4" public_interface="in" units="per_sec"/>
        <variable name="l_m5" public_interface="in" units="per_sec"/>
        <variable name="L1" public_interface="out" units="uM"/>
        <variable name="L2" public_interface="out" units="uM"/>
        <variable name="L3" public_interface="out" units="uM"/>
        <variable name="L4" public_interface="out" units="uM"/>
        <variable name="L5" public_interface="out" units="uM"/>
        <variable name="delta_SMC" public_interface="in" units="dimensionless"/>
        <variable name="delta2" public_interface="in" units="dimensionless"/>
        <variable name="V" public_interface="out" units="mV"/>
        <variable name="gamma" public_interface="in" units="dimensionless"/>
        <variable name="R" public_interface="in" units="mJ_per_K_per_mol"/>
        <variable name="T" public_interface="in" units="kelvin"/>
        <variable name="I_ca" public_interface="out" units="uA_per_cmsq"/>
        <variable name="gca" public_interface="in" units="nS_per_uM"/>
        <variable name="m" public_interface="out" units="dimensionless"/>
        <variable name="V_ca" public_interface="out" units="mV"/>
        <variable name="Vm" public_interface="in" units="mV"/>
        <variable name="km" public_interface="in" units="mV"/>
        <variable name="Ca_E" public_interface="out" units="uM"/>
        <!--var Ca_E: uM {init: 1600, pub: out}; -->
        <variable initial_value="1600" name="Ca_E0" units="uM"/>
        <variable initial_value="1600" name="Ca_E1" units="uM"/>
        <variable name="Ca_t" public_interface="out" units="uM"/>
        <!--      var t_ago1: second {init: 50, pub: out};
      var p_ago1: uM {init: 0, pub: out};-->
        <variable initial_value="260" name="t0_KCL" public_interface="out" units="second"/>
        <variable initial_value="260" name="t1_KCL" public_interface="out" units="second"/>
        <!--init: 280// var t1_KCL: second {init: 260, pub: out};   //init: 102-->
        <variable initial_value="2060" name="t2_KCL" public_interface="out" units="second"/>
        <!--init: 2100  //init: 2002-->
        <variable initial_value="2060" name="t3_KCL" public_interface="out" units="second"/>
        <variable initial_value="0" name="t1_E" public_interface="out" units="second"/>
        <variable initial_value="3000" name="t2_E" public_interface="out" units="second"/>
        <variable initial_value="-30" name="V1" public_interface="out" units="mV"/>
        <!--init: -39.8881623-->
        <variable initial_value="2" name="ne" public_interface="out" units="dimensionless"/>
        <variable initial_value="3" name="np" public_interface="out" units="dimensionless"/>
        <variable initial_value="3" name="nc" public_interface="out" units="dimensionless"/>
        <variable initial_value="4" name="ns" public_interface="out" units="dimensionless"/>
        <variable initial_value="1" name="ns0" public_interface="out" units="dimensionless"/>
        <variable initial_value="2" name="nv" public_interface="out" units="dimensionless"/>
        <variable initial_value="2" name="nm" public_interface="out" units="dimensionless"/>
        <variable initial_value="1" name="n_in" units="dimensionless"/>
        <variable initial_value="1" name="n_pm" units="dimensionless"/>
        <variable initial_value="1" name="n_release" units="dimensionless"/>
        <variable initial_value="1" name="n_serca" units="dimensionless"/>
        <variable initial_value="1" name="delta_SMC0" units="dimensionless"/>
        <variable name="exp1" units="dimensionless"/>
        <!--var K_SR: dimensionless {init: 1};  -->
        <!---39.8881623 mV// -30  mV //-54 mV==20mM KCL-->
        <variable initial_value="-60" name="V0" public_interface="out" units="mV"/>
        <variable name="rate1" public_interface="out" units="uM_per_sec"/>
        <variable name="rate_SR" public_interface="out" units="uM_per_sec"/>
        <variable name="rate_m" public_interface="out" units="uM_per_sec"/>
        <variable name="rate_m0" public_interface="out" units="uM_per_sec"/>
        <variable name="P_RyR_c" public_interface="out" units="dimensionless"/>
        <variable name="P_RyR_s" units="dimensionless"/>
        <variable name="J_inD" units="uM_per_sec"/>
        <variable name="J_inD0" units="uM_per_sec"/>
        <variable name="J_inD1" units="uM_per_sec"/>
        <variable name="J_inD2" units="uM_per_sec"/>
        <variable name="J_pmD" units="uM_per_sec"/>
        <variable name="J_in0" units="uM_per_sec"/>
        <variable name="J_in1" units="uM_per_sec"/>
        <variable name="J_in2" units="uM_per_sec"/>
        <variable name="J_pmDN" units="uM_per_sec"/>
        <variable name="J_pmN" units="uM_per_sec"/>
        <variable initial_value="0" name="J_L_typeD" units="uM_per_sec"/>
        <variable name="h_inf" units="dimensionless"/>
        <variable initial_value="0.762541971656097" name="h" units="dimensionless"/>
        <variable initial_value="0.762541971656097" name="h0" units="dimensionless"/>
        <!--init: 0.7614 //init: 0.8909  //init: 0.49536-->
        <variable initial_value="-39" name="Vh" units="mV"/>
        <!--init: -50-->
        <variable initial_value="-40" name="Vt" units="mV"/>
        <variable initial_value="1.2" name="out" units="dimensionless"/>
        <!--** extra-->
        <variable initial_value="18" name="kh" units="mV"/>
        <!--init: 20-->
        <!--var kh: mV {init: 12};-->
        <variable initial_value="7" name="kt" units="mV"/>
        <!-- ** extra-->
        <variable name="th" units="second"/>
        <variable initial_value="500" name="th0" units="second"/>
        <!--init: 200  //init: 50-->
        <variable initial_value="265" name="tb" units="second"/>
        <!--  var Ca_in_SMC2: uM {init: 0.167103, pub: out};
   var J_pm2: uM_per_sec;-->
        <variable initial_value="0" name="V_Ca" units="mV"/>
        <variable initial_value="0" name="oo" units="dimensionless"/>
        <variable name="Ca_dig_test" units="uM"/>
        <!--Buffering ...start-->
        <!--///        var bt: dimensionless {init: 100};
///        var kbt: dimensionless {init: 0.5};-->
        <!--bufferi ng ...end-->
        <!--Activation gate ODE1 .....starts.....................................................................-->
        <!--        var m1_inf: dimensionless;
        var m1: dimensionless {init: 0.49536};-->
        <!--        var Vtm: mV {init: -40}; -->
        <!--** extra-->
        <!--        var ktm: mV {init: 7};-->
        <!-- ** extra-->
        <!--        var tm1: second;
        var tm10: second {init: 10};-->
        <!-- ** extra
Activation gate ODE1 .... Ends............................................................-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Ca_E</ci>
                <piecewise>
                    <piece>
                        <ci>Ca_E1</ci>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t1_E</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t2_E</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>Ca_E0</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <!--V = time*0.24{per_sec}*1{mV}-90{mV};-->
            <!--V = V0+0.01{mV}*time*1{per_sec};-->
            <apply>
                <eq/>
                <ci>V</ci>
                <piecewise>
                    <piece>
                        <ci>V1</ci>
                        <apply>
                            <and/>
                            <apply>
                                <geq/>
                                <ci>time</ci>
                                <ci>t1_KCL</ci>
                            </apply>
                            <apply>
                                <leq/>
                                <ci>time</ci>
                                <ci>t2_KCL</ci>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <ci>V0</ci>
                    </otherwise>
                </piecewise>
            </apply>
            <apply>
                <eq/>
                <ci>L1</ci>
                <apply>
                    <divide/>
                    <ci>l_m1</ci>
                    <ci>l_1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>L2</ci>
                <apply>
                    <divide/>
                    <ci>l_m2</ci>
                    <ci>l_2</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>L3</ci>
                <apply>
                    <divide/>
                    <ci>l_m3</ci>
                    <ci>l_3</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>L4</ci>
                <apply>
                    <divide/>
                    <ci>l_m4</ci>
                    <ci>l_4</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>L5</ci>
                <apply>
                    <divide/>
                    <ci>l_m5</ci>
                    <ci>l_5</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_ca</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <ci>Ca_in_SMC</ci>
                                    <ci>Ca_E</ci>
                                </apply>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>nv</ci>
                                <ci>F</ci>
                            </apply>
                        </apply>
                        <apply>
                            <eq/>
                            <ci>V</ci>
                            <cn cellml:units="mV">0</cn>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V</ci>
                                    <apply>
                                        <minus/>
                                        <ci>Ca_in_SMC</ci>
                                        <apply>
                                            <times/>
                                            <ci>Ca_E</ci>
                                            <apply>
                                                <exp/>
                                                <apply>
                                                    <divide/>
                                                    <apply>
                                                        <times/>
                                                        <apply>
                                                            <minus/>
                                                            <ci>nv</ci>
                                                        </apply>
                                                        <ci>V</ci>
                                                        <ci>F</ci>
                                                    </apply>
                                                    <apply>
                                                        <times/>
                                                        <ci>R</ci>
                                                        <ci>T</ci>
                                                    </apply>
                                                </apply>
                                            </apply>
                                        </apply>
                                    </apply>
                                </apply>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">1</cn>
                                    <apply>
                                        <exp/>
                                        <apply>
                                            <divide/>
                                            <apply>
                                                <times/>
                                                <apply>
                                                    <minus/>
                                                    <ci>nv</ci>
                                                </apply>
                                                <ci>V</ci>
                                                <ci>F</ci>
                                            </apply>
                                            <apply>
                                                <times/>
                                                <ci>R</ci>
                                                <ci>T</ci>
                                            </apply>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                            <cn cellml:units="per_uM">1</cn>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
            <!--V_Ca        = V*(Ca_in_SMC-out*Ca_E*exp(-nv*V*F/(R*T)))/(1{dimensionless}-exp(-nv*V*F/(R*T)))*1{per_uM};-->
            <apply>
                <eq/>
                <ci>I_ca</ci>
                <apply>
                    <times/>
                    <ci>gca</ci>
                    <apply>
                        <power/>
                        <ci>m</ci>
                        <ci>nm</ci>
                    </apply>
                    <ci>V_ca</ci>
                    <ci>h</ci>
                    <cn cellml:units="M_per_cmsq">1</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>m</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <ci>V</ci>
                                        <ci>Vm</ci>
                                    </apply>
                                </apply>
                                <ci>km</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>h_inf</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>V</ci>
                                    <ci>Vh</ci>
                                </apply>
                                <ci>kh</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>th</ci>
                <apply>
                    <plus/>
                    <ci>th0</ci>
                    <apply>
                        <divide/>
                        <cn cellml:units="second">1</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <minus/>
                                            <ci>V</ci>
                                            <ci>Vt</ci>
                                        </apply>
                                    </apply>
                                    <ci>kt</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>h</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>h_inf</ci>
                        <ci>h</ci>
                    </apply>
                    <ci>th</ci>
                </apply>
            </apply>
            <!--//buffering       delta_SMC    = 1{dimensionless}/(1{dimensionless}+bt*kbt/sqr(kbt+Ca_in_SMC));-->
            <!--activation gate ODE2&#45;&#45;&#45;&#45;-starts&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;-->
            <!--        m1_inf        = 1{dimensionless}/(1{dimensionless}+exp(-(V-Vm)/km));
        tm1           = tm10+1{second}/(1{dimensionless}+exp((V-Vtm)/ktm));
        ode(m1, time) = (m1_inf-m1)/tm1;-->
            <!--activation gate ODE2&#45;&#45;&#45;&#45;-ends&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;
  ** extra-->
            <!--**extra inactivation gate-->
            <apply>
                <eq/>
                <ci>J_pm</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>n_pm</ci>
                        <ci>Vp</ci>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>np</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>Kp</ci>
                            <ci>np</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>np</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_pmN</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>n_pm</ci>
                        </apply>
                        <ci>Vp</ci>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>np</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>Kp</ci>
                            <ci>np</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>np</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_pmD</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC</ci>
                    <ci>J_pm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_pmDN</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>delta_SMC</ci>
                    </apply>
                    <ci>J_pm</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_inD</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC</ci>
                    <ci>J_in</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_inD0</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC</ci>
                    <ci>n_in</ci>
                    <ci>alpha0</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_inD1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>delta_SMC</ci>
                        <ci>n_in</ci>
                        <apply>
                            <minus/>
                            <ci>alpha1</ci>
                        </apply>
                        <ci>I_ca</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="umol_per_cmsq">2</cn>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_inD2</ci>
                <apply>
                    <times/>
                    <ci>delta_SMC</ci>
                    <ci>n_in</ci>
                    <ci>alpha2</ci>
                    <ci>p_agonist</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_in0</ci>
                <apply>
                    <times/>
                    <ci>n_in</ci>
                    <ci>alpha0</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_in1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>n_in</ci>
                        <apply>
                            <minus/>
                            <ci>alpha1</ci>
                        </apply>
                        <ci>I_ca</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="umol_per_cmsq">2</cn>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_in2</ci>
                <apply>
                    <times/>
                    <ci>n_in</ci>
                    <ci>alpha2</ci>
                    <ci>p_agonist</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_serca</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>n_serca</ci>
                        <ci>Ve</ci>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>ne</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>Ke</ci>
                            <ci>ne</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_in_SMC</ci>
                            <ci>ne</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_sercaN</ci>
                <apply>
                    <minus/>
                    <ci>J_serca</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_sercaDN</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>delta2</ci>
                    </apply>
                    <ci>J_serca</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_sercaD</ci>
                <apply>
                    <times/>
                    <ci>delta2</ci>
                    <ci>J_serca</ci>
                </apply>
            </apply>
            <!--J_serca = Ve*(pow(Ca_in_SMC, ne)-K_SR*Ca_SR)/(pow(Ke, ne)+pow(Ca_in_SMC, ne));-->
            <!---(K_SR{dimensionless}*Ca_SR)/Ca_SR);-->
            <apply>
                <eq/>
                <ci>J_release</ci>
                <apply>
                    <times/>
                    <ci>n_release</ci>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>k_ipr</ci>
                            <ci>P_ipr</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_RyR</ci>
                            <ci>P_RyR</ci>
                        </apply>
                        <ci>Jer</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Ca_SR</ci>
                        <ci>Ca_in_SMC</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_releaseD</ci>
                <apply>
                    <times/>
                    <ci>delta2</ci>
                    <ci>J_release</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>J_in</ci>
                <apply>
                    <times/>
                    <ci>n_in</ci>
                    <apply>
                        <plus/>
                        <apply>
                            <minus/>
                            <ci>alpha0</ci>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>alpha1</ci>
                                    <ci>I_ca</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <cn cellml:units="umol_per_cmsq">2</cn>
                                    <ci>F</ci>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <ci>alpha2</ci>
                            <ci>p_agonist</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--J_L_typeD = n_in*(alpha0-alpha1*gca*pow(m, nm)*V_Ca*1{M_per_cmsq}/(2{umol_per_cmsq}*F)+alpha2*p_agonist);-->
            <!--alpha0-alpha1*gca*0.622{dimesionless}*pow(m, nm)*V_ca*1{M_per_cmsq}/(2{umol_per_cmsq}*F));-->
            <apply>
                <eq/>
                <ci>P_ipr</ci>
                <apply>
                    <power/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>p_agonist</ci>
                            <ci>Ca_in_SMC</ci>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">1</cn>
                                <ci>y</ci>
                            </apply>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>p_agonist</ci>
                                <ci>L1</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>Ca_in_SMC</ci>
                                <ci>L5</ci>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="dimensionless">3</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_RyR</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>k_ryr0</ci>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>k_ryr1</ci>
                                    <apply>
                                        <power/>
                                        <ci>Ca_in_SMC</ci>
                                        <ci>nc</ci>
                                    </apply>
                                </apply>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <power/>
                                        <ci>k_ryr2</ci>
                                        <ci>nc</ci>
                                    </apply>
                                    <apply>
                                        <power/>
                                        <ci>Ca_in_SMC</ci>
                                        <ci>nc</ci>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_SR</ci>
                            <ci>ns</ci>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>ns0</ci>
                            <apply>
                                <power/>
                                <ci>k_ryr3</ci>
                                <ci>ns</ci>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_SR</ci>
                            <ci>ns</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_RyR_s</ci>
                <apply>
                    <divide/>
                    <apply>
                        <power/>
                        <ci>Ca_SR</ci>
                        <ci>ns</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>ns0</ci>
                            <apply>
                                <power/>
                                <ci>k_ryr3</ci>
                                <ci>ns</ci>
                            </apply>
                        </apply>
                        <apply>
                            <power/>
                            <ci>Ca_SR</ci>
                            <ci>ns</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_RyR_c</ci>
                <apply>
                    <plus/>
                    <ci>k_ryr0</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>k_ryr1</ci>
                            <apply>
                                <power/>
                                <ci>Ca_in_SMC</ci>
                                <ci>nc</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>k_ryr2</ci>
                                <ci>nc</ci>
                            </apply>
                            <apply>
                                <power/>
                                <ci>Ca_in_SMC</ci>
                                <ci>nc</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi1</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>l_m4</ci>
                                <ci>L2</ci>
                                <ci>L1</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>l_m2</ci>
                                <ci>L4</ci>
                                <ci>p_agonist</ci>
                            </apply>
                        </apply>
                        <ci>Ca_in_SMC</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>L4</ci>
                        <ci>L2</ci>
                        <apply>
                            <plus/>
                            <ci>L1</ci>
                            <ci>p_agonist</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi2</ci>
                <apply>
                    <divide/>
