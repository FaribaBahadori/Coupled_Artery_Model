    <component name="stress">
        <variable name="AMp" public_interface="in" units="dimensionless"/>
        <variable name="AM" public_interface="in" units="dimensionless"/>
        <variable name="stress_Index" units="dimensionless"/>
        <variable name="stress" units="dimensionless"/>
        <variable initial_value="2.06" name="Max_stress" units="dimensionless"/>
        <variable name="stress_dig" public_interface="in" units="dimensionless"/>
        <variable name="sqr_dif_stress" units="dimensionless"/>
        <variable initial_value="0" name="stress_d" public_interface="out" units="dimensionless"/>
        <variable name="time" public_interface="in" units="second"/>
        <variable name="AMpi" public_interface="in" units="dimensionless"/>
        <variable name="AMi" public_interface="in" units="dimensionless"/>
        <variable name="stress_Indexi" units="dimensionless"/>
        <variable name="stressi" units="dimensionless"/>
        <!--        var stress_d2: dimensionless {pub: out};-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>time</ci>
                    </bvar>
                    <ci>stress_d</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <power/>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <ci>stress_dig</ci>
                                <cn cellml:units="per_uM">1</cn>
                            </apply>
                            <apply>
                                <times/>
                                <ci>stress</ci>
                                <cn cellml:units="per_uM">1</cn>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <cn cellml:units="per_sec">1</cn>
                </apply>
            </apply>
            <!--        stress_d2 = sel
            case (time >= 266{second}) and (time < 2060{second}):
                stress_d;
            otherwise:
                0{dimensionless};
        endsel;-->
            <apply>
                <eq/>
                <ci>stress_Index</ci>
                <apply>
                    <plus/>
                    <ci>AMp</ci>
                    <ci>AM</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>stress</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <ci>AMp</ci>
                        <ci>AM</ci>
                    </apply>
                    <ci>Max_stress</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>sqr_dif_stress</ci>
                <apply>
                    <power/>
                    <apply>
                        <minus/>
                        <ci>stress_dig</ci>
                        <ci>stress</ci>
                    </apply>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>stress_Indexi</ci>
                <apply>
                    <plus/>
                    <ci>AMpi</ci>
                    <ci>AMi</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>stressi</ci>
                <apply>
                    <times/>
                    <apply>
                        <plus/>
                        <ci>AMpi</ci>
                        <ci>AMi</ci>
                    </apply>
                    <ci>Max_stress</ci>
                </apply>
            </apply>
        </math>
    </component>
